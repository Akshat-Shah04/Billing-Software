# Copy this file to .env and edit. .env is never committed.

PORT=4000

# Real PostgreSQL:   postgres://USER:PASSWORD@localhost:5432/billing
# Zero-setup option: pglite:./.data   (an embedded Postgres that stores files in ./.data)
DATABASE_URL=pglite:./.data

# Long random string used to sign login tokens. Change it!
JWT_SECRET=dev-only-change-me

# Used by `npm run seed` to create the first admin. Dev values only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Firm Admin

# Where each client's folder (details + bills, as a readable backup) is kept.
# Leave unset to use ./client-files in development.
# CLIENT_FILES_DIR=C:/Users/Public/Documents/Billing Software Client Files
